# Plantilla de variables de entorno del backend.
# Copia este archivo como Backend/.env y completa los valores. Nunca subas el .env a git.

# --- Django ---------------------------------------------------------------
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# --- Base de datos (sin estas variables se usa SQLite) ----------------------
DB_ENGINE=django.db.backends.postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=narino_cultura
DB_USER=postgres
DB_PASSWORD=

# --- Redis (opcional en desarrollo: sin él, Celery ejecuta las tareas en el mismo proceso)
REDIS_URL=

# --- Autenticación ----------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Pagos: Wompi (usa las llaves de PRUEBAS en desarrollo) -----------------
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
WOMPI_INTEGRITY_KEY=test_integrity_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx

# --- Correo: Resend (HTTPS). SMTP queda como respaldo -----------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@narinocultura.uk
EMAIL_FROM_NAME=Nariño Cultura
DEFAULT_FROM_EMAIL=noreply@narinocultura.uk
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# --- Archivos: Cloudinary (sin estas variables se guardan en disco) ---------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Inteligencia artificial ------------------------------------------------
AI_SERVICE_URL=

# --- Subastas ----------------------------------------------------------------
AUCTION_PAYMENT_HOURS=48

# --- Administrador inicial (solo se usa si el administrador no existe) ------
ADMIN_EMAIL=admin@narino.local
ADMIN_PASSWORD=
