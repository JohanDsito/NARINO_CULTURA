# Archivos que genera Postman al abrir esta carpeta ("Work with Git")
/.postman/
/postman/

# Volcados de código generados por herramientas
repomix-output.xml

# Variables de entorno: nunca se versionan (en mayo se filtraron credenciales por un .env)
.env
.env.*
!.env.example

# Estáticos que genera collectstatic al arrancar el contenedor
staticfiles/

# Cachés y reportes
.coverage
.coverage.*
coverage.json
coverage/
.ruff_cache/
__pycache__/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/

# Informes y documentos de trabajo locales (no se versionan)
/docs/informes/
