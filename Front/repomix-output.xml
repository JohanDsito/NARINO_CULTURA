      getApiErrorMessage(
        axiosError('Error directo'),
      ),
    ).toBe('Error directo')
  })

  it('returns detail from API error objects', () => {
    expect(
      getApiErrorMessage(
        axiosError({
          detail: 'Token inválido',
        }),
      ),
    ).toBe('Token inválido')
  })

  it('returns first string field from API error objects', () => {
