# Django Configuration
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1,narinocultura-production.up.railway.app

# ===== DATABASE CONFIGURATION =====
# For LOCAL DOCKER DEVELOPMENT (docker-compose):
DB_ENGINE=django.db.backends.postgresql
DB_NAME=narinocultura
DB_USER=narinocultura
DB_PASSWORD=narinocultura123
DB_HOST=narinocultura-postgres
DB_PORT=5432

# For PRODUCTION (Railway):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=<your-railway-password>
# DB_HOST=viaduct.proxy.rlwy.net
# DB_PORT=47598

# ===== REDIS CONFIGURATION =====
# Local Docker
REDIS_URL=redis://redis:6379/0

# Production Railway
# REDIS_URL=redis://<your-railway-redis-credentials>

# ===== CORS & FRONTEND =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ===== MICROSERVICES =====
N8N_WEBHOOK_URL=http://n8n:5678/webhook/narinocultura
AI_SERVICE_URL=http://ai-service:8001

# ===== PAYMENT INTEGRATION (Wompi) =====
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_prod_xxxx
WOMPI_PRIVATE_KEY=priv_prod_xxxx
WOMPI_INTEGRITY_KEY=integrity_xxxx

# ===== EMAIL CONFIGURATION =====
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=narinocultura@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@narinocultura.uk

